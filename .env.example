JARVIS_MONGODB_URI=mongodb://127.0.0.1:27017
JARVIS_MONGODB_DATABASE=jarvis
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_ACCESS_TOKEN=replace-this-with-a-random-token
# Sandbox connectors never access real accounts.
JARVIS_STEP_DELAY=0.6

# Live AI agent (local Ollama)
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3:4b
# Gmail address is set after verifying the signed-in Brave session in Connections.
JARVIS_EMAIL_ADDRESS=

# Dedicated agent browser; native desktop session required for account sign-in.
JARVIS_BROWSER_PROFILE=.local/jarvis-browser
JARVIS_BROWSER_HEADLESS=false
JARVIS_BRAVE_PROFILE=.local/jarvis-brave
JARVIS_FIREFOX_PROFILE=.local/jarvis-firefox
# Optional executable paths when browsers are not on PATH.
JARVIS_BRAVE_BINARY=
JARVIS_FIREFOX_BINARY=
JARVIS_GECKODRIVER_BINARY=
JARVIS_OLLAMA_TIMEOUT=180
